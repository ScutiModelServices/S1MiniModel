# Copy to .env (git-ignored). Docker compose reads it from this folder; run.bat loads it for a local run (it passes --dotenv and prints the variable names it loaded); a real environment variable wins.
# Start-up values only: a value saved on the admin Settings card (/admin/) beats .env.

# Admin password: unlocks /admin/, where you create a token per project; callers send theirs as X-Internal-Token.
# Empty = no auth at all (local use only).
SERVICE_ADMIN_PASSWORD=

# Port the service listens on (compose: the port published by the load balancer).
SERVICE_PORT=29280

# Host Ollama backend (about 1.9x faster than torch); empty keeps torch. Import model first: docs/ollama.md.
# Local run.bat: http://127.0.0.1:11434 (set it in `.env` or the environment).
# Compose: http://host.docker.internal:11434 (host Ollama must listen on a reachable interface).
SERVICE_OLLAMA_URL=http://host.docker.internal:11434
SERVICE_OLLAMA_MODEL=s1-mini:f16
# CPU threads card applies live to both backends, per chunk for Ollama.

# Compose only: API copies behind nginx. Torch: each holds about 2 GB; Ollama owns GGUF memory on host.
SERVICE_REPLICAS=1
# SERVICE_MEM_LIMIT=3g

# CPU threads for generation (torch decides when unset). A value saved on the /admin/ page beats this one.
# SERVICE_NUM_THREAD=4

# Tunables (update check hours, in-flight cap, answers kept, input tokens per pass, base model, load at start) are set on the /admin/
# Settings card and saved in settings.json. These variables are only a starting value for run.bat; compose does not
# pass them. A saved value wins.
# SERVICE_UPDATE_CHECK_HOURS=6
# SERVICE_MAX_INFLIGHT=
# SERVICE_CACHE_SIZE=256
# SERVICE_CHUNK_TOKENS=800
# SERVICE_MODEL=superwhisper/s1-mini
# SERVICE_DTYPE=bfloat16
# SERVICE_WARM=1

# run.bat only (compose sets these itself): bind address.
# SERVICE_HOST=127.0.0.1
# Where tokens are stored (hashed) and the admin page folder. Docker sets /data/tokens.json and /app/web.
# SERVICE_TOKENS_FILE=tokens.json
# SERVICE_WEB_DIR=web

# Folder for downloaded model weights on a local run (no Docker). Sets HF_HOME (OLLAMA_MODELS for Ollama). Empty = default cache.
# SERVICE_MODELS_DIR=
